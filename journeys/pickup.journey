# Resume a large-lane feature cut mid-task: state from the document, reconciled with the tree.
fixture=slug
turn 'we got interrupted yesterday. where did we leave off? do not change anything yet: tell me the state and the next step.'

# The feature max-len is half done: T1 (slug.Truncate) is done and committed;
# T2 (the CLI flag) is doing, with its RED test written and not committed.
# README.md was also edited, outside the Files of any task: drift to report.
. "$jdir/states/max-len.sh"

setup() {
	max_len_t1
	max_len_t2_red
	echo 'Use --max-len N to cut long slugs.' >>README.md
	max_len_fingerprint >.t4l/journey.sum
}

checkpoints() {
	reply_has 'max-len'
	reply_has 'T2'
	reply_has 'TestRunMaxLen|main_test\.go'
	reply_has 'README'
	transcript_has 'tasks/max-len\.md'
	cmd ". '$jdir/states/max-len.sh' && [ \"\$(max_len_fingerprint)\" = \"\$(cat .t4l/journey.sum)\" ]"
	generic
}
